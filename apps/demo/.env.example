# Leave OPENAI_API_KEY empty to run in demo mode (scripted stream, no network).
# Any OpenAI-compatible endpoint works: OpenAI, OpenRouter, Groq, Together, Ollama, LM Studio, vLLM...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
MODEL=gpt-4o-mini
# Set to "off" if your endpoint/model doesn't support tool calling.
OPENAI_TOOLS=on
